{
  "name": "orbit-lost",
  "private": true,
  "version": "1.0.0",
  "description": "ORBIT//LOST - a retro pixel-art orbital survival arcade game",
  "author": "Biterate-7",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "ingest": "vite-node scripts/ingest.ts --",
    "icon": "node scripts/build-icon.mjs",
    "electron:start": "npm run build && electron .",
    "pack:win": "npm run build && electron-builder --win dir --x64 --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "jpeg-js": "^0.4.4",
    "typescript": "5.6",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
